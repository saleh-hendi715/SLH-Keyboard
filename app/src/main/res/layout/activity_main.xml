<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/slh_bg_dark"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SLH KEYBOARD ✦"
            android:textColor="@color/slh_gold"
            android:textSize="26sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="20dp" />

        <Button
            android:id="@+id/btnEnableKb"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1. تفعيل لوحة المفاتيح"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btnSelectKb"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="2. اختيار SLH KEYBOARD"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="البصمة الشخصية:"
            android:textColor="@color/slh_text_dark"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etUserName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="الاسم"
            android:textColor="@color/slh_text_dark"
            android:textColorHint="@color/slh_muted"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etSignature"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="التوقيع السريع"
            android:textColor="@color/slh_text_dark"
            android:textColorHint="@color/slh_muted"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btnSaveIdentity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="حفظ البصمة الشخصية"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="لون الهوية:"
            android:textColor="@color/slh_text_dark"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp">

            <Button
                android:id="@+id/btnAccentGold"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="ذهبي"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btnAccentCyan"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="سيان"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btnAccentPurple"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="بنفسجي"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btnAccentSilver"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="فضي" />
        </LinearLayout>

        <Switch
            android:id="@+id/swLightMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="الوضع النهاري (الفاتح)"
            android:textColor="@color/slh_text_dark"
            android:paddingVertical="8dp" />

        <Switch
            android:id="@+id/swNumRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="إظهار صف الأرقام"
            android:textColor="@color/slh_text_dark"
            android:paddingVertical="8dp" />

        <Switch
            android:id="@+id/swSound"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="صوت الضغط على المفاتيح"
            android:textColor="@color/slh_text_dark"
            android:paddingVertical="8dp" />

        <Switch
            android:id="@+id/swVibrate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="الاهتزاز عند الضغط"
            android:textColor="@color/slh_text_dark"
            android:paddingVertical="8dp" />

        <Switch
            android:id="@+id/swIncognito"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="الوضع الخفي (عدم حفظ الحافظة)"
            android:textColor="@color/slh_text_dark"
            android:paddingVertical="8dp" />

    </LinearLayout>
</ScrollView>
          
