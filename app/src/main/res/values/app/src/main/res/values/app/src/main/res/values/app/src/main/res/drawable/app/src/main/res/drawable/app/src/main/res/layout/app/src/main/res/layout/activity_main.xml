<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/slh_bg_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- الشعار والعنوان -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingBottom="20dp">

            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:contentDescription="SLH Logo"
                android:src="@drawable/ic_slh_logo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="SLH KEYBOARD"
                android:textColor="@color/slh_gold"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="لوحة مفاتيح احترافية بخصوصية كاملة"
                android:textColor="@color/slh_muted"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- بطاقة التفعيل -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="تفعيل لوحة المفاتيح"
                android:textColor="@color/slh_gold"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnEnableKb"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:backgroundTint="@color/slh_gold"
                android:text="1. تفعيل SLH KEYBOARD"
                android:textColor="#080B12"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnSelectKb"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/slh_key_fn_dark"
                android:text="2. اختيار SLH KEYBOARD"
                android:textColor="@color/slh_text_dark" />
        </LinearLayout>

        <!-- بطاقة البصمة الشخصية -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="البصمة والتوقيع السريع"
                android:textColor="@color/slh_gold"
                android:textSize="16sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etUserName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:backgroundTint="@color/slh_gold"
                android:hint="الاسم أو اللقب"
                android:textColor="@color/slh_text_dark"
                android:textColorHint="@color/slh_muted" />

            <EditText
                android:id="@+id/etSignature"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:backgroundTint="@color/slh_gold"
                android:hint="التوقيع السريع"
                android:textColor="@color/slh_text_dark"
                android:textColorHint="@color/slh_muted" />

            <Button
                android:id="@+id/btnSaveIdentity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/slh_key_fn_dark"
                android:text="حفظ البصمة 🪪"
                android:textColor="@color/slh_text_dark" />
        </LinearLayout>

        <!-- بطاقة لون الهوية -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="لون الهوية (Accent)"
                android:textColor="@color/slh_gold"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnAccentGold"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/slh_gold"
                    android:text="ذهبي"
                    android:textColor="#080B12"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnAccentCyan"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/slh_cyan"
                    android:text="سيان"
                    android:textColor="#080B12"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnAccentPurple"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/slh_purple"
                    android:text="بنفسجي"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnAccentSilver"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/slh_silver"
                    android:text="فضي"
                    android:textColor="#080B12"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- بطاقة الإعدادات -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="تخصيص الكيبورد"
                android:textColor="@color/slh_gold"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Switch
                android:id="@+id/swLightMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="8dp"
                android:text="الوضع الفاتح (Light Mode)"
                android:textColor="@color/slh_text_dark" />

            <Switch
                android:id="@+id/swNumRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="8dp"
                android:text="إظهار صف الأرقام العلوي"
                android:textColor="@color/slh_text_dark" />

            <Switch
                android:id="@+id/swSound"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="8dp"
                android:text="صوت الضغط على المفاتيح"
                android:textColor="@color/slh_text_dark" />

            <Switch
                android:id="@+id/swVibrate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="8dp"
                android:text="الاهتزاز عند الكتابة"
                android:textColor="@color/slh_text_dark" />

            <Switch
                android:id="@+id/swIncognito"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="8dp"
                android:text="الوضع الخفي (إيقاف قراءة الحافظة)"
                android:textColor="@color/slh_text_dark" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
